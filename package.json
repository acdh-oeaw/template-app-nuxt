{
	"$schema": "https://www.schemastore.org/package",
	"name": "@acdh-oeaw/app",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"analyze": "nuxt analyze --dotenv ./.env.local",
		"build": "nuxt build --dotenv ./.env.local",
		"build:static": "nuxt generate --dotenv ./.env.local",
		"clean": "nuxt cleanup",
		"dev": "nuxt dev --dotenv ./.env.local",
		"docker:versions": "node scripts/docker-versions.ts",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "oxlint",
		"lint:fix": "oxlint --fix",
		"postinstall": "nuxt prepare --dotenv ./.env.local",
		"preinstall": "npx only-allow pnpm",
		"start": "nuxt preview --dotenv ./.env.local",
		"styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"test": "node --test tests/*.test.ts",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts",
		"test:e2e:docker": "node scripts/test-e2e-docker.ts",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:update-snapshots": "pnpm run test:e2e:docker --update-snapshots=changed --grep 'should not have visible changes'",
		"test:e2e:update-snapshots:ci": "node scripts/update-snapshots-ci.ts",
		"types:check": "nuxt typecheck --dotenv ./.env.local"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/lucide": "^1.2.153",
		"@iconify-json/simple-icons": "^1.2.102",
		"@lucide/vue": "^1.71.0",
		"@nuxt/fonts": "^1.2.0",
		"@nuxt/icon": "^2.6.2",
		"@nuxt/image": "^2.2.1",
		"@nuxt/scripts": "^1.3.12",
		"@nuxtjs/color-mode": "^4.1.0",
		"@nuxtjs/i18n": "^10.6.0",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"nuxt": "^4.6.4",
		"pino-http": "^11.0.0",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0",
		"vue": "^3.5.45",
		"vue-i18n": "^11.4.18",
		"vue-router": "^5.5.0"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@dotenvx/dotenvx": "^2.38.2",
		"@nuxt/devtools": "^4.1.0",
		"@nuxt/hints": "^1.1.5",
		"@nuxt/kit": "^4.6.4",
		"@nuxt/test-utils": "^4.4.0",
		"@playwright/test": "^1.65.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-playwright": "^2.12.2",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2006",
		"postcss": "^8.5.32",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.0.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:typescript-native-bridge@6.0.3-bridge.12.tsgo.7.0.2",
		"vite": "^8.3.7",
		"vue-tsc": "^3.3.14"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply",
						"media"
					]
				}
			]
		}
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26.13.1",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "node",
			"version": "^26.13.1",
			"onFail": "download"
		}
	}
}
